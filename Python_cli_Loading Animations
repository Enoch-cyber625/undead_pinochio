def Title(title_string):
    lines = title_string.split('\n') 
    string_width = max(len(i) for i in lines)
    string_height = len(lines)
    term_width, term_height = shutil.get_terminal_size()
    top_padding = (term_height - string_height) //2    
    left_padding = (term_width - string_width) //2
    print("\n"*top_padding)
    for i in lines:
        print(" "*left_padding + i.ljust(string_width))
    time.sleep(2)
    clear_screen()

def Game_Start(loading_screen_tips_list , title_string) :
    Loading(random.choice(loading_screen_tips_list))
    Title(title_string)

def write_text(text , time_diff = 0.07):
    for i in text :
        print(i , end = "" ,  flush= True)
        time.sleep(time_diff)
